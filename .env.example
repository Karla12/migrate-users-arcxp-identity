# Arc XP API
URL_ARC_XP=https://arc.example.com
AUTH_TOKEN_ARC_XP=your_arc_xp_token_here
SECRET=your_secret_here

# Request / batching behavior
MAX_ROWS_PER_REQUEST=100
MAX_RETRIES=6
RETRY_DELAY_MS=10000
DELAY_BETWEEN_REQUESTS_MS=938

# Server
PORT=3000
NODE_ENV=development

# Local paths
LOG_DIR=./logs
CSV_UPLOAD_DIR=./csvs
LOG_REQUEST_DIR=./logs_requests

# NOTE: Do NOT commit real secrets. Copy this file to .env and fill values.
